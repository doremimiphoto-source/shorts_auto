<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shortsauto.batch_0700</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_PROJECT_PATH/scripts/run_batch.sh</string>
    </array>

    <!-- 조회수 분석 결과: 아침(06시) 최약(9 vpd) → 점심 12:30(28 vpd)으로 이동. 라벨(0700)은 이력상 유지 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>   <integer>12</integer>
        <key>Minute</key> <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_PROJECT_PATH/logs/launchd_0700.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_PROJECT_PATH/logs/launchd_0700.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
